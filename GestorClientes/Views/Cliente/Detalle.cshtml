@using GestorClientes.Application.Dtos
@model ClienteDto

@{
    ViewData["Title"] = "Detalle del Cliente";
}

<div class="cliente-page">

    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-person-vcard"></i> @Model.Nombre @Model.Apellido1 @Model.Apellido2
                </h1>
                <p class="page-subtitle">Detalle del cliente</p>
            </div>
            <a asp-action="Index" class="btn btn-crear">
                <i class="bi bi-arrow-left"></i> Regresar
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-7">
            <div class="table-card h-100">
                <div class="table-card-header">
                    <h2 class="table-card-title"><i class="bi bi-person"></i> Datos personales</h2>
                </div>
                <div class="table-card-body">
                    <div class="row">
                        <div class="col-sm-4">
                            <div class="detalle-label">Nombre</div>
                            <div class="detalle-valor">@Model.Nombre</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="detalle-label">Primer apellido</div>
                            <div class="detalle-valor">@Model.Apellido1</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="detalle-label">Segundo apellido</div>
                            <div class="detalle-valor">@Model.Apellido2</div>
                        </div>
                    </div>
                    <div class="detalle-label">Correo</div>
                    <div class="detalle-valor mb-0">
                        <i class="bi bi-envelope text-muted"></i> @Model.Correo
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="table-card h-100">
                <div class="table-card-header">
                    <h2 class="table-card-title"><i class="bi bi-telephone"></i> Teléfonos</h2>
                    <span class="badge rounded-pill text-bg-light">@Model.Telefonos.Count</span>
                </div>
                <div class="table-card-body">
                    @foreach (var telefono in Model.Telefonos)
                    {
                        <span class="telefono-badge fs-6">
                            <i class="bi bi-telephone"></i> @telefono.Numero
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a asp-action="Modificar" asp-route-id="@Model.Id" class="btn btn-cliente">
            <i class="bi bi-pencil"></i> Modificar
        </a>
        <button type="button"
                class="btn btn-outline-danger btn-eliminar-cliente"
                data-id="@Model.Id"
                data-nombre="@Model.Nombre @Model.Apellido1 @Model.Apellido2">
            <i class="bi bi-trash"></i> Eliminar
        </button>
    </div>

    @await Html.PartialAsync("_Eliminar")
</div>

@section Scripts {
    <script src="~/js/cliente.js" asp-append-version="true"></script>
}

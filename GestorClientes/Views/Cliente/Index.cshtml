@using GestorClientes.Application.Dtos
@model List<ClienteDto>

<h2>Listado de Clientes</h2>

@* Un solo contenedor de mensajes: lo usa TempData (registrar/modificar) y cliente.js (eliminar) *@
<div id="mensajeCliente"
     class="alert @(TempData["Mensaje"] != null ? "alert-success" : "d-none")"
     role="alert">@TempData["Mensaje"]</div>

<p>
    <a asp-action="Registrar" class="btn btn-primary">+ Registrar nuevo cliente</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Teléfonos</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var cliente in Model)
        {
            <tr id="fila-cliente-@cliente.Id">
                <td>
                    @cliente.Nombre
                    @cliente.Apellido1
                    @cliente.Apellido2
                </td>

                <td>@cliente.Correo</td>

                <td>
                    @foreach (var telefono in cliente.Telefonos)
                    {
                        <div>@telefono.Numero</div>
                    }
                </td>

                <td>
                    <a asp-action="Detalle"
                       asp-route-id="@cliente.Id">
                        Ver Detalle
                    </a>
                    |
                    <a asp-action="Modificar"
                       asp-route-id="@cliente.Id">
                        Modificar
                    </a>
                    |
                    <button type="button"
                            class="btn btn-link text-danger p-0 align-baseline btn-eliminar-cliente"
                            data-id="@cliente.Id"
                            data-nombre="@cliente.Nombre @cliente.Apellido1 @cliente.Apellido2">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@await Html.PartialAsync("_Eliminar")

@section Scripts {
    <script src="~/js/cliente.js" asp-append-version="true"></script>
}